# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
# ENABLE_REQUEST_LOGS — request/response logs (default: false).
# Keep false in production: setting it true writes every SSE chunk with a
# synchronous fs.appendFileSync, blocking the event loop under load.
# ENABLE_REQUEST_LOGS=false
ENABLE_REQUEST_LOGS=false
# Observability (request-detail capture). Default false; when enabled it adds a
# per-request JSON.stringify plus batched DB writes. Keep false under high traffic.
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# SearXNG endpoint for the built-in unauthenticated web-search provider.
# `docker-compose.yml` bundles an always-on `searxng` service (container
# `9router-searxng`) that the app reaches by DNS name on the shared network, so
# web search works out of the box with the default below. Override this only to
# point at a different SearXNG instance (e.g. https://searx.example.com/search).
# The endpoint MUST serve `?format=json`; the bundled service enables it via
# docker/searxng/settings.yml.
SEARXNG_URL=http://searxng:8080/search

# ─── Database mode ───────────────────────────────────────────────────────
# "sqlite" (default) uses a local SQLite file under DATA_DIR/db.
# "mariadb" uses a MariaDB/MySQL server. In Docker Compose the MariaDB sidecar
# is a profile-gated service: set DB_MODE=mariadb, then run
#   docker compose --profile mariadb up -d     (or: ./start.sh)
DB_MODE=sqlite

# MariaDB connection (used only when DB_MODE=mariadb).
# DB_HOST must be reachable from the app container. The Compose MariaDB service
# is named "mariadb" and its container_name is "9router-mariadb"; both resolve
# on the shared docker network. DB_PASSWORD is auto-generated + persisted here
# by ./start.sh when left empty (MariaDB mode only).
DB_HOST=9router-mariadb
DB_PORT=3306
DB_USER=9router
DB_PASSWORD=change-me
DB_NAME=9router
# MariaDB root password. Falls back to DB_PASSWORD when left empty.
DB_ROOT_PASSWORD=change-me-root
# Connection pool size (recommended default: 20).
# MariaDB's default max_connections is 151, so 20 gives safe headroom for
# concurrent SSE streams without exhausting the server. The previous default
# of 10 was conservative.
DB_CONNECTION_LIMIT=20

# Docker Compose MariaDB sidecar (used only by docker-compose.yml).
# MARIA_IMAGE=         # MariaDB image (default: mariadb:11)
# MARIA_HOST_PORT=     # host port published for MariaDB (default: DB_PORT)
# DB_MIGRATE_FORCE=    # set to 1 to force the one-time SQLite -> MariaDB copy

# Docker Compose SearXNG sidecar (used only by docker-compose.yml).
# Always-on; no host port is published. See SEARXNG_URL above.
# SEARXNG_IMAGE=       # SearXNG image (default: searxng/searxng:latest)
# SEARXNG_SECRET=      # session-signing key (default: generated value in compose)

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
